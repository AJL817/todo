# ─────────────────────────────────────────────────────────────
# GitHub OAuth (필수) — docs/LOGIN-SETUP.md 에 만드는 절차가 있다
# ─────────────────────────────────────────────────────────────
# GitHub OAuth App 의 Client ID / Client Secret.
# 시크릿은 절대 소스에 넣지 말고 .env.local 에만 둔다 (.env.local 은 커밋되지 않는다).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 콜백 주소. 비워 두면 요청이 도착한 호스트에서 자동으로 만든다.
# GitHub OAuth App 에 등록한 값과 글자 하나까지 같아야 하므로,
# 배포 환경에서는 명시하는 편이 안전하다.
# AUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback

# 세션 유효 기간(일). 기본값 14
# SESSION_TTL_DAYS=14

# 테스트용 GitHub 스텁 주소. 평소에는 비워 둔다 (비우면 실제 github.com 을 쓴다).
# GITHUB_OAUTH_BASE=
# GITHUB_API_BASE=

# ─────────────────────────────────────────────────────────────
# 데이터베이스
# ─────────────────────────────────────────────────────────────
# MongoDB 접속 문자열.
# 비워 두면 mongodb-memory-server 가 127.0.0.1:27017 에 로컬 mongod 를 띄우고
# 데이터를 .mongo-data/ 에 영속 저장한다 (별도 설치 불필요).
#
# 직접 설치한 mongod 나 Atlas 를 쓰려면 아래 주석을 풀고 값을 채운다.
# MONGODB_URI=mongodb://127.0.0.1:27017/todo-app
# MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/todo-app

# MONGODB_URI 를 비워 둔 경우에만 쓰이는 데이터베이스 이름 (기본값 todo-app)
# MONGO_DB_NAME=todo-app

# MONGODB_URI 를 비워 둔 경우 로컬 mongod 가 쓸 포트 (기본값 27017)
# 27017 이 이미 다른 것에 쓰이면 바꾼다
# MONGO_LOCAL_PORT=27017
